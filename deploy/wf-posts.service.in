[Unit]
Description=wf-posts: converts html to Markdown with wf for posts
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
Environment="HOME=@HOME_DIR@"
Environment="PATH=@PATH@"
Environment="http_proxy=@PROXY_URL@"
Environment="https_proxy=@PROXY_URL@"
Environment="no_proxy=127.0.0.1,localhost"
Environment="HTTP_PROXY=@PROXY_URL@"
Environment="HTTPS_PROXY=@PROXY_URL@"
Environment="NO_PROXY=127.0.0.1,localhost"
ExecStart="@PROJECT_DIR@/build/wf-posts" -listen "@LISTEN_ADDR@" -wf "@WF_BIN@" -workdir /tmp/wf-posts
# Binding the Docker gateway fails until Docker has created the network.
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=20s
NoNewPrivileges=true
# Not PrivateTmp: failed conversions stay in /tmp/wf-posts for inspection.

[Install]
WantedBy=default.target
